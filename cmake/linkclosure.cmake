


file(GLOB indexes "${REPLY_DIR}/index-*.json")
if(NOT indexes)
    message(FATAL_ERROR "no file API reply under ${REPLY_DIR}")
endif()
list(SORT indexes)
list(GET indexes -1 index)
file(READ "${index}" json)
string(JSON codemodel GET "${json}" reply codemodel-v2 jsonFile)
file(READ "${REPLY_DIR}/${codemodel}" json)
string(JSON nconfigs LENGTH "${json}" configurations)
set(targetfile "")
math(EXPR last "${nconfigs} - 1")
foreach(i RANGE ${last})
    string(JSON name GET "${json}" configurations ${i} name)
    if(NOT (name STREQUAL "${CONFIG}" OR nconfigs EQUAL 1))
        continue()
    endif()
    string(JSON ntargets LENGTH "${json}" configurations ${i} targets)
    math(EXPR lastt "${ntargets} - 1")
    foreach(j RANGE ${lastt})
        string(JSON tname GET "${json}" configurations ${i} targets ${j} name)
        if(tname STREQUAL "${TARGET}")
            string(JSON targetfile GET "${json}" configurations ${i} targets ${j} jsonFile)
        endif()
    endforeach()
endforeach()
if(NOT targetfile)
    message(FATAL_ERROR "the file API reply has no target ${TARGET} for ${CONFIG}")
endif()
file(READ "${REPLY_DIR}/${targetfile}" tj)
string(JSON nfrags ERROR_VARIABLE err LENGTH "${tj}" link commandFragments)
if(err)
    message(FATAL_ERROR "the file API reply has no link line for ${TARGET}: ${err}")
endif()
set(items)
if(nfrags GREATER 0)
    math(EXPR lastf "${nfrags} - 1")
    foreach(k RANGE ${lastf})
        string(JSON role GET "${tj}" link commandFragments ${k} role)
        if(NOT (role STREQUAL "libraries" OR role STREQUAL "libraryPath" OR role STREQUAL "frameworkPath"))
            continue()
        endif()
        string(JSON frag GET "${tj}" link commandFragments ${k} fragment)
        separate_arguments(words NATIVE_COMMAND "${frag}")
        foreach(w IN LISTS words)
            if(w MATCHES "[/\\\\]" AND EXISTS "${BUILD_DIR}/${w}")
                get_filename_component(w "${BUILD_DIR}/${w}" ABSOLUTE)
            endif()
            list(APPEND items "${w}")
        endforeach()
    endforeach()
endif()
set(msvc "")
set(cc "")
foreach(item IN LISTS items)
    if(item MATCHES " ")
        set(quoted "\"${item}\"")
    else()
        set(quoted "${item}")
    endif()
    string(APPEND msvc "${quoted}\n")
    
    
    if(item MATCHES "^[A-Za-z0-9_]+\\.lib$")
        string(REGEX REPLACE "\\.lib$" "" bare "${item}")
        string(APPEND cc "-l${bare}\n")
    else()
        string(APPEND cc "${quoted}\n")
    endif()
endforeach()
file(MAKE_DIRECTORY "${OUT_DIR}")
file(WRITE "${OUT_DIR}/link-msvc.rsp" "${msvc}")
file(WRITE "${OUT_DIR}/link-cc.rsp" "${cc}")
