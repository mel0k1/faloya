


include_guard(GLOBAL)
include(FetchContent)


function(faloya_blessed_rows outvar)
    file(STRINGS "${CMAKE_SOURCE_DIR}/src/blessed.txt" lines)
    set(rows)
    foreach(line IN LISTS lines)
        string(REGEX REPLACE "#.*" "" line "${line}")
        string(STRIP "${line}" line)
        if(line STREQUAL "")
            continue()
        endif()
        string(REGEX REPLACE "[ \t]+" "|" row "${line}")
        string(REPLACE "|" ";" fields "${row}")
        list(LENGTH fields nfields)
        if(NOT nfields EQUAL 4)
            message(FATAL_ERROR "src/blessed.txt: a row has ${nfields} fields, not 4: ${line}")
        endif()
        list(APPEND rows "${row}")
    endforeach()
    set(${outvar} "${rows}" PARENT_SCOPE)
endfunction()


function(faloya_sidecar_value sidecar key outvar)
    string(REGEX REPLACE "//[^\n]*" "" text "${sidecar}")
    set(value "")
    if(text MATCHES "(^|[\n;])[ \t]*${key}[ \t]*=[ \t]*\"([^\"]*)\"[ \t]*;")
        set(value "${CMAKE_MATCH_2}")
    elseif(text MATCHES "(^|[\n;])[ \t]*${key}[ \t]*=[ \t]*(true|false)[ \t]*;")
        set(value "${CMAKE_MATCH_2}")
    elseif(text MATCHES "(^|[\n;])[ \t]*${key}[ \t]*=[ \t]*\\[([^]]*)\\][ \t]*;")
        string(REGEX MATCHALL "\"[^\"]*\"" items "${CMAKE_MATCH_2}")
        foreach(item IN LISTS items)
            string(REGEX REPLACE "^\"(.*)\"$" "\\1" item "${item}")
            list(APPEND value "${item}")
        endforeach()
    endif()
    set(${outvar} "${value}" PARENT_SCOPE)
endfunction()


function(faloya_symbol_table pkgroot pkgname outfile)
    file(GLOB_RECURSE goosefiles "${pkgroot}/*.fal")
    set(names)
    foreach(f IN LISTS goosefiles)
        file(READ "${f}" text)
        string(REGEX REPLACE "//[^\n]*" "" text "${text}")
        string(REGEX MATCHALL
               "extern[ \t\r\n]+(\"[A-Za-z_][A-Za-z0-9_]*\"[ \t\r\n]+)?fn[ \t\r\n]+[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)?[^;]*"
               matches "${text}")
        foreach(m IN LISTS matches)
            if(m MATCHES "=[ \t\r\n]*\"([A-Za-z_][A-Za-z0-9_]*)\"[ \t\r\n]*$")
                list(APPEND names "${CMAKE_MATCH_1}")
            elseif(m MATCHES "^extern[ \t\r\n]+\"([A-Za-z_][A-Za-z0-9_]*)\"")
                list(APPEND names "${CMAKE_MATCH_1}")
            elseif(m MATCHES "^extern[ \t\r\n]+fn[ \t\r\n]+([A-Za-z_][A-Za-z0-9_]*)::([A-Za-z_][A-Za-z0-9_]*)")
                list(APPEND names "${CMAKE_MATCH_2}")
            elseif(m MATCHES "^extern[ \t\r\n]+fn[ \t\r\n]+([A-Za-z_][A-Za-z0-9_]*)")
                list(APPEND names "${CMAKE_MATCH_1}")
            endif()
        endforeach()
    endforeach()
    if(names)
        list(REMOVE_DUPLICATES names)
        list(SORT names)
    endif()
    set(src "/* Generated by cmake/package.cmake for the builtin package ${pkgname}: the C\n")
    string(APPEND src "   functions its extern fns name, which a JIT run looks up through\n")
    string(APPEND src "   faloya_symbols_${pkgname}. Do not edit. */\n\n")
    string(APPEND src "typedef struct { const char *name; const void *addr; } faloya_symbol;\n\n")
    foreach(n IN LISTS names)
        string(APPEND src "void ${n}(void);\n")
    endforeach()
    string(APPEND src "\nconst faloya_symbol *faloya_symbols_${pkgname}(void) {\n")
    string(APPEND src "    static const faloya_symbol table[] = {\n")
    foreach(n IN LISTS names)
        string(APPEND src "        { \"${n}\", (const void *)&${n} },\n")
    endforeach()
    string(APPEND src "        { 0, 0 }\n    };\n    return table;\n}\n")
    file(CONFIGURE OUTPUT "${outfile}" CONTENT "${src}" @ONLY)
endfunction()


function(faloya_builtin_package pkgname source ref)
    if(source MATCHES "^\\./" OR source MATCHES "^\\.\\./" OR source MATCHES "^/")
        get_filename_component(srcdir "${CMAKE_SOURCE_DIR}/${source}" ABSOLUTE)
    else()
        if(source MATCHES "://" OR source MATCHES "@")
            set(url "${source}")
        else()
            string(REGEX MATCHALL "/" slashes "${source}")
            list(LENGTH slashes nslashes)
            if(nslashes EQUAL 1)
                set(url "https://github.com/${source}")
            else()
                set(url "https://${source}")
            endif()
        endif()
        FetchContent_Declare(faloya_pkg_${pkgname}
            GIT_REPOSITORY "${url}" GIT_TAG "${ref}" GIT_SHALLOW TRUE GIT_SUBMODULES_RECURSE TRUE
            SOURCE_DIR "${CMAKE_BINARY_DIR}/pkg/src/${pkgname}/${ref}")
        FetchContent_GetProperties(faloya_pkg_${pkgname})
        if(NOT faloya_pkg_${pkgname}_POPULATED)
            message(STATUS "package ${pkgname}: fetching ${url} at ${ref}")
            FetchContent_Populate(faloya_pkg_${pkgname})
        endif()
        set(srcdir "${faloya_pkg_${pkgname}_SOURCE_DIR}")
    endif()
    if(NOT EXISTS "${srcdir}/${pkgname}.fal")
        message(FATAL_ERROR "package ${pkgname}: ${srcdir} has no ${pkgname}.fal")
    endif()
    set(target "")
    if(EXISTS "${srcdir}/${pkgname}.build")
        file(READ "${srcdir}/${pkgname}.build" sidecar)
        faloya_sidecar_value("${sidecar}" cmake_target target)
        if(target)
            add_subdirectory("${srcdir}" "${CMAKE_BINARY_DIR}/pkg/build/${pkgname}" EXCLUDE_FROM_ALL)
            if(NOT TARGET ${target})
                message(STATUS "package ${pkgname}: its CMakeLists built nothing, so it is not "
                               "compiled in (a submodule it needs may not be checked out)")
                return()
            endif()
        else()
            faloya_sidecar_value("${sidecar}" c_sources sources)
            if(sources)
                set(target faloya_pkg_${pkgname})
                set(abs)
                foreach(s IN LISTS sources)
                    list(APPEND abs "${srcdir}/${s}")
                endforeach()
                add_library(${target} STATIC ${abs})
                faloya_sidecar_value("${sidecar}" c_include includes)
                foreach(i IN LISTS includes)
                    target_include_directories(${target} PRIVATE "${srcdir}/${i}")
                endforeach()
                faloya_sidecar_value("${sidecar}" c_defines defines)
                if(defines)
                    target_compile_definitions(${target} PRIVATE ${defines})
                endif()
                faloya_sidecar_value("${sidecar}" c_libs libs)
                if(libs)
                    target_link_libraries(${target} PUBLIC ${libs})
                endif()
            endif()
        endif()
    endif()
    set_property(GLOBAL APPEND PROPERTY FALOYA_BUILTIN_NAMES "${pkgname}")
    set_property(GLOBAL APPEND PROPERTY FALOYA_BUILTIN_SRCDIRS "${srcdir}/")
    if(NOT target)
        
        set_property(GLOBAL APPEND PROPERTY FALOYA_BUILTIN_RSPDIRS "")
        message(STATUS "package ${pkgname}: built in from ${srcdir} (Faloya only)")
        return()
    endif()
    target_link_libraries(faloya PRIVATE ${target})
    set(gen "${CMAKE_BINARY_DIR}/generated")
    faloya_symbol_table("${srcdir}" "${pkgname}" "${gen}/faloya_symbols_${pkgname}.c")
    target_sources(faloya PRIVATE "${gen}/faloya_symbols_${pkgname}.c")
    set_source_files_properties("${gen}/faloya_symbols_${pkgname}.c" PROPERTIES
                                COMPILE_OPTIONS "$<IF:$<BOOL:${MSVC}>,/w,-w>")
    
    
    
    file(CONFIGURE OUTPUT "${gen}/faloya_linkprobe_${pkgname}.c"
         CONTENT "/* Its link line is the package's link closure. */\nint main(void) { return 0; }\n")
    add_executable(faloya_linkprobe_${pkgname} EXCLUDE_FROM_ALL "${gen}/faloya_linkprobe_${pkgname}.c")
    target_link_libraries(faloya_linkprobe_${pkgname} PRIVATE ${target})
    set(rspdir "${CMAKE_BINARY_DIR}/pkg/${pkgname}")
    add_custom_command(TARGET faloya POST_BUILD
        COMMAND "${CMAKE_COMMAND}" "-DREPLY_DIR=${CMAKE_BINARY_DIR}/.cmake/api/v1/reply"
                "-DTARGET=faloya_linkprobe_${pkgname}" "-DCONFIG=$<CONFIG>"
                "-DBUILD_DIR=${CMAKE_BINARY_DIR}" "-DOUT_DIR=${rspdir}/$<CONFIG>"
                -P "${CMAKE_SOURCE_DIR}/cmake/linkclosure.cmake"
        COMMENT "link closure of the package ${pkgname}"
        VERBATIM)
    set_property(GLOBAL APPEND PROPERTY FALOYA_BUILTIN_RSPDIRS "${rspdir}")
    target_compile_definitions(faloya PRIVATE "FALOYA_BUILTIN_RSPDIR_${pkgname}=\"${rspdir}/$<CONFIG>\"")
    message(STATUS "package ${pkgname}: built in from ${srcdir}")
endfunction()


function(faloya_builtin_packages wanted)
    faloya_blessed_rows(rows)
    set(done)
    foreach(row IN LISTS rows)
        string(REPLACE "|" ";" fields "${row}")
        list(GET fields 0 import)
        list(GET fields 1 pkg)
        list(GET fields 2 source)
        list(GET fields 3 ref)
        if(NOT (wanted STREQUAL "all" OR import IN_LIST wanted OR pkg IN_LIST wanted))
            continue()
        endif()
        if(pkg IN_LIST done)
            continue()
        endif()
        list(APPEND done "${pkg}")
        faloya_builtin_package("${pkg}" "${source}" "${ref}")
    endforeach()
    
    
    
    
    cmake_file_api(QUERY API_VERSION 1 CODEMODEL 2)
    get_property(names GLOBAL PROPERTY FALOYA_BUILTIN_NAMES)
    get_property(srcdirs GLOBAL PROPERTY FALOYA_BUILTIN_SRCDIRS)
    get_property(rspdirs GLOBAL PROPERTY FALOYA_BUILTIN_RSPDIRS)
    file(READ "${CMAKE_SOURCE_DIR}/src/blessed.txt" blessed)
    set(h "// Generated by cmake/package.cmake: the blessed table and the packages compiled\n")
    string(APPEND h "// into this compiler. Do not edit.\n#pragma once\n\nnamespace faloya {\n\n")
    string(APPEND h "inline const char *blessed_table = R\"GSBL(${blessed})GSBL\";\n\n")
    set(i 0)
    foreach(n IN LISTS names)
        list(GET rspdirs ${i} rspdir)
        if(rspdir)
            string(APPEND h "extern \"C\" const faloya_symbol *faloya_symbols_${n}(void);\n")
        endif()
        math(EXPR i "${i} + 1")
    endforeach()
    string(APPEND h "\ninline const BuiltinPackage builtin_packages[] = {\n")
    set(i 0)
    foreach(n IN LISTS names)
        list(GET srcdirs ${i} srcdir)
        list(GET rspdirs ${i} rspdir)
        if(rspdir)
            string(APPEND h "    { \"${n}\", faloya_symbols_${n}, \"${srcdir}\", FALOYA_BUILTIN_RSPDIR_${n} },\n")
        else()
            string(APPEND h "    { \"${n}\", nullptr, \"${srcdir}\", \"\" },\n")
        endif()
        math(EXPR i "${i} + 1")
    endforeach()
    string(APPEND h "    { nullptr, nullptr, nullptr, nullptr },\n};\n\n}  // namespace faloya\n")
    file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/generated/builtin_packages.h" CONTENT "${h}" @ONLY)
    target_include_directories(faloya PRIVATE "${CMAKE_BINARY_DIR}/generated")
endfunction()
