import ast;

fn show(src: const u8[:]) {
    var p: ast::Parser = ast::Parser { .. };
    let root = ast::parse(src, p);
    if !p.ok {
        var msg: u8[>..] = [];
        ast::error_line(p, msg);
        print(msg);
        return;
    }
    var out: u8[>..] = [];
    ast::dump(p, root, 0, out);
    print(out);
    print("nodes: ${p.nodes.len} tokens: ${p.toks.len}");
}

fn main() {
    show("fn main() { let x = 1 + 2 * 3; print(\"x=\${x}\"); }");
    print("----");
    show("fn add(a: i64, b: i64) -> i64 { return a + b; }");
    print("----");
    show("fn f(xs: i32[:]) { for x in xs { if x > 0 { continue; } } }");
    print("----");
    show("fn g(a: i64[3]) { for x: i32 in 0..9 { print(x); } for y, i: i32 in a { print(y, i); } for &z in a { z += 1; } }");
    print("----");
    show("fn h() { var r: i64& .= q; r .= s; }");
    print("----");
    show("fn broken( { let = ;");
}
