struct Point { x: i64, y: i64 = 1 }
enum Choice { A, B }

fn direct() -> i64 {
    var s: i64 = 0;
    const for <C> in [3, 4] { s += C; }
    return s;
}

fn required<T>() -> i64 {
    var n: i64 = 0;
    const for <N, A> in fields<T> { const if !has_default<A> { n += 1; } else { n += 2; } }
    return n;
}

fn show<E>(value: E) {
    match value { const for <N, V> in variants<E> { V => if true { print(N); }, } }
}

fn dup(p: Point) -> Point {
    Point {
        const for <N, A> in fields<Point> {
            A: p.A,
        }
    }
}

fn main() {
    print(direct());
    print(required<Point>());
    show(Choice.A);
    show(Choice.B);
    let q = dup(Point { 5, 6 });
    print(q.x, " ", q.y);
}
