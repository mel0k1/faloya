fn sum_upto(n: i32) -> i64 {
    var s: i64 = 0;
    for x: i32 in 0..n { s += x; }
    s
}

fn main() {
    for x: i32 in 0..3 { print("r ", x); }
    for x: u8 in 2 { print("c ", x); }
    for x, i in 7..9 { print("ri ", i, " ", x); }
    var f: i64[3] = [5, 6, 7];
    for v, i in f { print("f ", i, " ", v); }
    for v, i: i32 in f { print("fi ", i, " ", v); }
    for &x in f { x = x * 10; }
    print("mut fixed ", f[0], " ", f[2]);
    var g: i64[>..] = [1, 2, 3];
    for &x, i in g { x = x + i; }
    print("mut grow ", g[0], " ", g[1], " ", g[2]);
    var w: const u8[:][2] = ["ab", "c"];
    for word, i: i64 in w { print("w ", i, " ", word, " ", word.len); }
    var s: i64[:] = g[0..2];
    for v in s { print("s ", v); }
    print("sum ", sum_upto(4));
}
