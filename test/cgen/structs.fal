struct Point { x: i64, y: i64 }
struct Named { name: const u8[:], p: Point, tag: i64 = 99 }

fn dist2(a: Point, b: Point) -> i64 {
    let dx = a.x - b.x;
    let dy = a.y - b.y;
    dx * dx + dy * dy
}

fn move_by(p: Point&, dx: i64, dy: i64) {
    p.x += dx;
    p.y += dy;
}

fn main() {
    let a = Point { x: 1, y: 2 };
    let b = Point { x: 4, y: 6 };
    print("dist2: ", dist2(a, b));
    var c = Point { x: 0, y: 0 };
    move_by(c, 3, 4);
    print("moved: ", c.x, " ", c.y);
    let eq = Point { x: 3, y: 4 };
    print("eq: ", c == eq, " ", c == b);
    let n = Named { name: "pt", p: c };
    print("named: ", n.name, " ", n.tag, " ", n.p.x);
    let d: Named = Named { .. };
    print("default: ", d.tag, " ", d.p.x, " ", d.name.len);
    let arr: Point[2] = [a, b];
    print("arr of struct: ", arr[0].y, " ", arr[1].x);
    var list: Point[>..] = [];
    list.push(a);
    list.push(b);
    print("list: ", list.len, " ", list[1].y);
    let s = n.p;
    print("copy: ", s.x, " ", s.y, " ", s == c);
}
