fn sum_fixed(a: i64[4]) -> i64 {
    var s: i64 = 0;
    for i in 0..4 { s += a[i]; }
    s
}

fn bump(a: i64[3]&) {
    for i in 0..3 { a[i] = a[i] * 2 + 1; }
}

fn main() {
    var a: i64[4] = [10, 20, 30, 40];
    print("sum: ", sum_fixed(a));
    a[1] = 7;
    print("after set: ", sum_fixed(a), " ", a[1]);
    var m: i64[3] = [1, 2, 3];
    bump(m);
    print("bumped: ", m[0], " ", m[1], " ", m[2]);
    var grid: i64[2][2] = [[1, 2], [3, 4]];
    print("grid: ", grid[0][1], " ", grid[1][0]);
    var bytes: u8[5] = ['h', 'e', 'l', 'l', 'o'];
    print("bytes[0]: ", bytes[0], " len ", 5);
    var total: i64 = 0;
    for v in a { total += v; }
    print("for-over: ", total);
    var view: i64[:] = a[1..3];
    print("slice: ", view[0], " ", view[1], " ", view.len);
}
