fn total(xs: i64[:]) -> i64 {
    var s: i64 = 0;
    for x in xs { s += x; }
    s
}

fn main() {
    let s = "hello, cgen";
    print("len: ", s.len, " first: ", s[0], " last: ", s[s.len - 1]);
    let head = s[..5];
    let tail = s[7..];
    print("head: ", head, " tail: ", tail);
    let mid = s[2..7];
    print("mid: ", mid, " mid.len: ", mid.len);
    print("cmp: ", "abc" == "abc", " ", "abc" == "abd", " ", head == "hello");
    var nums: i64[>..] = [];
    nums.push(5);
    nums.push(3);
    nums.push(8);
    print("nums: ", nums.len, " ", nums[0], " ", nums[2]);
    print("total: ", total(nums));
    nums[1] = 30;
    print("patched: ", total(nums));
    let part = nums[1..3];
    print("part: ", part.len, " ", part[0], " ", part[1]);
    var buf: u8[>..] = [];
    buf.push('o');
    buf.push('k');
    print("buf: ", buf.len);
    var fixed: i64[4] = [9, 8, 7, 6];
    print("fixed total: ", total(fixed), " fixed part: ", fixed[2..4].len);
    for x in nums[..2] { print("item: ", x); }
}
