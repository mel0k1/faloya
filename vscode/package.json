{
  "name": "faloya-language",
  "displayName": "Faloya Language",
  "description": "Syntax highlighting, snippets, file icons and compiler tasks (run, build, check, format) for the Faloya language.",
  "version": "0.1.0",
  "publisher": "mel0k1",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/mel0k1/faloya.git", "directory": "vscode" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Snippets"],
  "keywords": ["faloya", "goose"],
  "main": "./src/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [{
      "id": "faloya",
      "aliases": ["Faloya", "faloya"],
      "icon": { "dark": "./fileicons/faloya-icon-dark.png", "light": "./fileicons/faloya-icon.png" },
      "extensions": [".fal"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [
      { "language": "faloya", "scopeName": "source.faloya", "path": "./syntaxes/faloya.tmLanguage.json" },
      { "scopeName": "markdown.faloya.codeblock", "path": "./syntaxes/faloya.markdown.json", "injectTo": ["text.html.markdown"], "embeddedLanguages": { "meta.embedded.block.faloya": "faloya" } }
    ],
    "snippets": [{ "language": "faloya", "path": "./snippets/faloya.json" }],
    "commands": [
      { "command": "faloya.run", "title": "Run with JIT", "category": "Faloya", "icon": "$(play)", "enablement": "editorLangId == faloya && isWorkspaceTrusted" },
      { "command": "faloya.build", "title": "Build Executable", "category": "Faloya", "enablement": "editorLangId == faloya && isWorkspaceTrusted" },
      { "command": "faloya.check", "title": "Check Program", "category": "Faloya", "enablement": "editorLangId == faloya && isWorkspaceTrusted" },
      { "command": "faloya.format", "title": "Format File", "category": "Faloya", "enablement": "editorLangId == faloya && isWorkspaceTrusted" },
      { "command": "faloya.showOutput", "title": "Show Compiler Output", "category": "Faloya" }
    ],
    "menus": {
      "editor/title": [{ "command": "faloya.run", "when": "editorLangId == faloya && isWorkspaceTrusted", "group": "navigation" }]
    },
    "keybindings": [
      { "command": "faloya.run", "key": "ctrl+shift+b", "mac": "cmd+shift+b", "when": "editorLangId == faloya && editorTextFocus && isWorkspaceTrusted && config.faloya.useRunKeybindings" },
      { "command": "faloya.run", "key": "f5", "when": "editorLangId == faloya && editorTextFocus && isWorkspaceTrusted && config.faloya.useRunKeybindings" }
    ],
    "configuration": {
      "title": "Faloya",
      "properties": {
        "faloya.compilerPath": { "type": "string", "default": "", "scope": "resource", "description": "Compiler executable or command on PATH. Empty searches faloya and build/{Release,Debug}/faloya in the workspace, then PATH. Relative paths use the workspace folder. Supports ${workspaceFolder}." },
        "faloya.entryFile": { "type": "string", "default": "", "scope": "resource", "description": "Program entry file, relative to the workspace folder. Empty checks/runs the current file. Set this when editing imported modules. Supports ${workspaceFolder}." },
        "faloya.useRunKeybindings": { "type": "boolean", "default": true, "description": "Run with JIT on Ctrl+Shift+B (Cmd+Shift+B on macOS) and F5 while editing Faloya. Disable to use VS Code's usual task keybindings." },
        "faloya.checkOnSave": { "type": "boolean", "default": true, "scope": "resource", "description": "Check saved Faloya files on open and save, and show errors as diagnostics." },
        "faloya.checkTimeout": { "type": "number", "default": 15000, "minimum": 1000, "maximum": 300000, "scope": "resource", "description": "Maximum time in milliseconds for a background compiler check." },
        "faloya.runArguments": { "type": "array", "items": { "type": "string" }, "default": [], "scope": "resource", "description": "Program arguments passed after -- by Run with JIT. Each item is one argument." }
      }
    },
    "taskDefinitions": [{
      "type": "faloya", "required": ["action"],
      "properties": {
        "action": { "type": "string", "enum": ["run", "check", "build", "format"], "description": "Compiler operation. Run uses the JIT and is the contributed build task; build makes an executable beside the source with faloya build." },
        "file": { "type": "string", "description": "Source file relative to the workspace folder. Defaults to faloya.entryFile or the active file. Supports ${workspaceFolder} and ${file}." }
      }
    }],
    "problemMatchers": [{
      "name": "faloya", "owner": "faloya-task", "source": "Faloya", "fileLocation": ["autoDetect", "${workspaceFolder}"],
      "pattern": { "regexp": "^(.+?):(\\d+): (error|warning): (.*)$", "file": 1, "line": 2, "severity": 3, "message": 4 }
    }],
    "configurationDefaults": { "[faloya]": { "editor.tabSize": 4, "editor.insertSpaces": true } }
  }
}
