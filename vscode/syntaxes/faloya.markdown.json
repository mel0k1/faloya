{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Faloya in Markdown code blocks",
  "scopeName": "markdown.faloya.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [{ "include": "#faloya-code-block" }],
  "repository": {
    "faloya-code-block": {
      "begin": "(^|\\G)(\\s*)((`|~)\\4{2,})\\s*(?i:(faloya)((\\s+|:|,|\\{|\\?)[^`]*)?$)",
      "name": "markup.fenced_code.block.markdown",
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3\\4*)\\s*$",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "5": { "name": "fenced_code.block.language.markdown" },
        "6": { "name": "fenced_code.block.language.attributes.markdown" }
      },
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.faloya",
          "patterns": [{ "include": "source.faloya" }]
        }
      ]
    }
  }
}
